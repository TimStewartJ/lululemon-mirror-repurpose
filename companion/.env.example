# Companion service configuration.
# Copy this file to .env and adjust values as needed. Never commit the real .env file.

# HTTP port the companion web server listens on.
COMPANION_PORT=4317

# Interface the companion binds to. Defaults to 127.0.0.1 (loopback-only,
# same machine only). Set to 0.0.0.0 (or a specific LAN address) to also
# serve the UI to other devices on the network -- for example, once the
# Mirror has its own Wi-Fi connection and you want to control it without a
# USB cable plugged into this machine. Any non-loopback value REQUIRES
# COMPANION_ACCESS_TOKEN to be set below, or the companion refuses to start.
# COMPANION_HOST=127.0.0.1

# Shared secret required on every /api/device, /api/companion, and
# /media-files request via the X-Companion-Token header, whenever
# COMPANION_HOST is not loopback-only. Not needed (and has no effect) for
# the default loopback-only setup. When set, LAN-mode media playback also
# forwards this token to the device (inside the play request body) so the
# device can attach it when it fetches hosted media back from this
# companion; USB playback never needs it, since it always resolves to a
# 127.0.0.1 URL over the adb reverse tunnel. Generate one with, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# COMPANION_ACCESS_TOKEN=

# Directory used for local persistent state: the paired bearer token,
# cached companion settings, and the media library. Defaults to a
# .data directory inside the companion project when unset.
# COMPANION_DATA_DIR=

# Directory that holds uploaded/served media files.
# Defaults to <COMPANION_DATA_DIR>/media when unset.
# COMPANION_MEDIA_ROOT=

# Explicit path to the adb executable. When unset, the companion searches
# ANDROID_SDK_ROOT / ANDROID_HOME platform-tools, then the PATH.
# ADB_PATH=

# Preferred local loopback port for `adb forward` to the device's control
# API (which listens on 127.0.0.1:8787 on-device). If this port is already
# in use, the companion asks adb to allocate a free port dynamically.
COMPANION_ADB_FORWARD_PORT=18787

# Preferred device-side port for adb reverse media delivery. The installer
# tries this port and the next nine ports because Android 6 does not support
# dynamic reverse-port allocation.
MIRROR_MEDIA_REVERSE_PORT=14317

# TCP port the Mirror Home control API listens on, on-device (localhost only).
DEVICE_API_PORT=8787

# Explicit base URL (e.g. http://192.168.1.20:4317) the Mirror can use to
# fetch companion-hosted media over LAN. Only needed for LAN-connected
# devices playing hosted media files; USB connections always use
# `adb reverse` and never need this. When unset, the companion auto-selects
# one of its own private (RFC1918/link-local) IPv4 interface addresses -- it
# never trusts a browser-supplied Host header for this, since that would be
# an SSRF vector. Set this explicitly if the host has multiple network
# interfaces and the wrong one gets auto-selected, or if the companion sits
# behind a stable reverse-proxy/port-forward.
# COMPANION_PUBLIC_URL=
